# ============================================================
# Momen Tasks Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://momen_app:momen_pass@localhost:5432/momen_tasks?schema=public

# --- Redis (Upstash-compatible) ---
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# --- JWT ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- Encryption (for task content at rest) ---
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes-256-gcm

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Sign-In ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Email (Resend-compatible) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@momen.app

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=momen-tasks-attachments
R2_PUBLIC_URL=

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=debug
